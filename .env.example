# Aurora backend
AURORA_PORT=8787

# AI provider
AI_PROVIDER=huggingface
HF_BASE_URL=https://router.huggingface.co/v1
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest

# Capability-specific Hugging Face models. Leave unset to use Aurora defaults.
HF_REASONING_MODEL=openai/gpt-oss-120b:fastest
HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_STT_MODEL=openai/whisper-large-v3
HF_TTS_MODEL=espnet/kan-bayashi_ljspeech_vits
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_VIDEO_MODEL=Lightricks/LTX-Video
HF_TTS_PROVIDER=

# Aurora Live provider selection.
# Gemini remains the default live path; OpenAI Realtime is an optional adapter.
AURORA_LIVE_PROVIDER=gemini
AURORA_LIVE_LANGUAGE=pt-BR
GEMINI_LIVE_MODEL=gemini-3.8-live
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-realtime-2.1

# Aura System bridge. The agent may only call /api/* routes on this fixed base URL.
# Configure these in Render environment variables, never in source control.
AURA_SYSTEM_URL=
AURA_SYSTEM_TOKEN=
AURA_SYSTEM_TIMEOUT_MS=15000
