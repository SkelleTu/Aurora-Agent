{
  "name": "aurora-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:backend\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:backend": "node backend/server.mjs",
    "build": "vite build",
    "start": "node scripts/aurora-start.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:live": "node scripts/aurora-live-smoke.mjs",
    "control:smoke": "node scripts/aurora-control.mjs smoke.live"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.0",
    "playcanvas": "^2.22.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
